# Copy this file to .env.local and fill in your own Supabase project's values.
# Get them from: Supabase dashboard -> Project Settings -> API.
#
# Leave unset (or delete .env.local) to run the app in demo mode, using the
# bundled sample data in lib/demoData.js instead of a real database.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
